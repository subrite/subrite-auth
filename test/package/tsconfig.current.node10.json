    "moduleResolution": "node10",
    "ignoreDeprecations": "6.0",
    "exactOptionalPropertyTypes": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM"]
  },
  "include": ["current"],
  "exclude": ["current/*.cts", "current/*.tsx"]
}
