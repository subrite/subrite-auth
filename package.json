{
  "name": "@subrite/next-auth-provider",
  "version": "0.2.1",
  "description": "NextAuth provider for Subrite",
  "author": {
    "name": "Subrite",
    "email": "post@subrite.no",
    "url": "https://www.subrite.no"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/subrite/subrite-auth.git"
  },
  "homepage": "https://github.com/subrite/subrite-auth#readme",
  "bugs": "https://github.com/subrite/subrite-auth/issues",
  "keywords": [
    "next-auth",
    "subrite",
    "nextjs"
  ],
  "type": "module",
  "files": [
    "dist"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "compile": "tsup src/index.ts --format cjs,esm --dts --clean --target node22 --external next-auth",
    "typecheck": "tsc",
    "test": "node --test \"test/**/*.test.ts\"",
    "test:package": "node scripts/test-package.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier \"{src,example,test,scripts}/**/*.{ts,cts}\" --write",
    "format:check": "prettier \"{src,example,test,scripts}/**/*.{ts,cts}\" --check",
    "upgrade": "npx npm-check-updates --upgrade",
    "prepare": "husky",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test && npm run test:package"
  },
  "peerDependencies": {
    "next-auth": "^4.24.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "next-auth": "4.24.15",
    "prettier": "3.10.1",
    "tsup": "9.0.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.json": [
      "prettier --write"
    ]
  }
}
